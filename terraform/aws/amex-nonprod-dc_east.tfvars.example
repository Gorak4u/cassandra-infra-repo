# ===========================================================================
# amex / nonprod / dc_east -- PUPPET MASTER ONLY, GREENFIELD ACCOUNT
# ===========================================================================
#
# The master is built ONCE, before anything else, and on its own. Everything
# else in the estate needs it to already exist: a Cassandra node that boots
# without a master installs the agent, finds nothing to talk to, and sits
# there as an EC2 charge with no Cassandra on it.
#
#   cp amex-nonprod-dc_east.tfvars.example amex-nonprod-dc_east.tfvars
#   # create the deploy key secret first (BEFORE YOU RUN below)
#   ./bootstrap-account.sh amex-nonprod-dc_east.tfvars
#
# The copy is gitignored (*.tfvars), this template is not. Keep it that way.
#
# This variant assumes an EMPTY ACCOUNT: it creates the VPC, the security
# group and the IAM role rather than referencing existing ones. For an account
# that already has a landing zone, delete the three create_* toggles below and
# supply vpc_id / subnet_ids / security_group_ids / iam_instance_profile
# instead.
#
# WHAT bootstrap-account.sh SUPPLIES ITSELF -- do not hand-write these:
#   products=["puppetmaster"]   passed as -var, overrides anything here
#   join_secret_arn             read back from Secrets Manager after creating
#   backend.hcl                 written from customer/environment/region
#   the S3 state bucket         named amex-nonprod-tfstate
#   the join secret             32 random bytes, created if absent
#   the Route 53 A record       upserted if a hosted zone matches dns_domain
#
# ---------------------------------------------------------------------------
# BEFORE YOU RUN
# ---------------------------------------------------------------------------
# The deploy key secret. The NAME is already set below; the secret itself has
# to exist before the master boots. Gorak4u/cassandra-control-repo is PRIVATE,
# so it needs a credential to clone at first boot:
#
#      ssh-keygen -t ed25519 -f ./control-repo-key -N '' -C 'puppetmaster'
#      # add ./control-repo-key.pub to the repo as a read-only Deploy Key
#      aws secretsmanager create-secret --region us-east-1 \
#        --name amex/nonprod/control-repo-deploy-key \
#        --secret-string "$(cat ./control-repo-key)"
#      shred -u ./control-repo-key
#
#    The secret's value must be the RAW PEM, not JSON. The instance tag holds
#    only the secret ID -- tags are readable via IMDS by anything on the box --
#    and 10-metadata-aws.sh fetches the key with the instance role, which is
#    why create_iam_role below scopes GetSecretValue to exactly this secret.
#
#    NOTE ON EGRESS: an SSH clone needs outbound 22 to github.com. If your
#    egress policy blocks 22, keep the key and use github.com's 443 endpoint
#    instead -- set control_repo_url to
#    ssh://git@ssh.github.com:443/Gorak4u/cassandra-control-repo.git
# ---------------------------------------------------------------------------

# --- Identity of this slice ------------------------------------------------
# These three select inventory/customers/amex/nonprod.yaml, which already
# declares the node: products.puppetmaster.clusters.pm, count 1, role
# puppetmaster, name_prefix pm, sizing medium. You are not describing a
# machine here, only naming the slice.
customer    = "amex"
environment = "nonprod"
datacenter  = "dc_east"

# Restricting to the master. bootstrap-account.sh passes this as -var anyway;
# repeated here so a plain `terraform apply -var-file=...` does the same thing
# rather than trying to build the whole slice.
products = ["puppetmaster"]

region = "us-east-1"

# ===========================================================================
# NAMES -- baked into certificates, expensive to change later
# ===========================================================================
# dns_domain replaces the inventory default 'lab.pfpt', which is a lab value
# (see inventory/defaults.yaml). It becomes the certname suffix, so the master
# is pm1.<dns_domain>, and it reaches Hiera as the `domain` fact.
dns_domain = "nonprod.amex.internal"

# NOT "puppet.nonprod.amex.internal", and this is verified rather than
# preference. The master's cert carries exactly what
# profile_puppetmaster_pfpt::dns_alt_names lists in the control repo at
# data/customers/amex/nonprod/products/puppetmaster/clusters/pm.yaml:
#
#     'puppet', "pm1.%{facts.domain}", 'pm1', '172.30.30.10'
#
# There is no puppet.<domain> entry, so pointing agents at that name gives a
# TLS name mismatch that reads as a certificate bug. Use the certname, or add
# the alias to dns_alt_names first.
puppet_server = "pm1.nonprod.amex.internal"

# NOTE: no Route 53 hosted zone exists for this domain yet. bootstrap-account.sh
# detects that and prints the record to add by hand instead of failing --
# "no Route 53 hosted zone for ... -- add pm1.nonprod.amex.internal -> <ip>".
# Nothing else needs DNS until the first agent joins.

# ===========================================================================
# THE MACHINE
# ===========================================================================
# Instance type is NOT set here: the inventory says sizing 'medium', which
# defaults.yaml resolves to m6i.large (8 GB). That is measured, not guessed --
# puppetserver was OOM-killed mid-compilation at 2 GB and the symptom read as
# "Connection refused ... port 8140".
#
# The AMI must be Ubuntu 20.04 to match the inventory's os: ubuntu2004, which
# selects the control repo's data/os/ layers. Nothing cross-checks the two, so
# a 22.04 image here applies 20.04 package names and paths against it.
#
# Canonical's current us-east-1 focal image, read 2026-09-16. It moves with
# every Canonical release; refresh it with
#   aws ssm get-parameter --region us-east-1 --name /aws/service/canonical/ubuntu/server/20.04/stable/current/amd64/hvm/ebs-gp2/ami-id --query Parameter.Value --output text
# A NEW ID DOES NOT REPLACE A RUNNING MASTER: instances.tf:225 has
# ignore_changes = [ami], so changing this only affects instances built after.
ami_id = "ami-0fb0b230890ccd1e6"

root_volume_size_gb     = 50
data_volume_size_gb     = 0 # the master keeps code and certs on root
disable_api_termination = true

# No key_name: reach the box with `aws ssm start-session --target <id>`.
# attach_ssm_policy defaults true, and bootstrap-account.sh needs SSM anyway
# to wait for user-data to finish.

# ===========================================================================
# NETWORK -- created, not referenced
# ===========================================================================
# One AZ is enough for one master. create_vpc builds a private subnet per AZ
# listed, plus a public subnet in the first for the NAT gateway.
#
# create_nat_gateway MUST stay true: at first boot the master installs Puppet
# packages and runs `r10k puppetfile install` against the Puppet Forge. In a
# subnet with no egress it dies there. (VPC endpoints are the cheaper
# production answer; they do not cover the Forge.)
create_vpc            = true
vpc_cidr              = "10.80.0.0/16"
availability_zones    = ["us-east-1a"]
create_nat_gateway    = true
create_security_group = true

# ===========================================================================
# IAM -- created, not referenced
# ===========================================================================
# Builds the role and instance profile, attaches the SSM managed policy, and
# scopes secretsmanager:GetSecretValue to the two secrets named in this file.
create_iam_role   = true
attach_ssm_policy = true

# ===========================================================================
# CONTROL REPO -- what makes this a master rather than an empty Ubuntu box
# ===========================================================================
# SSH, not the https:// URL, and deliberately: 30-role-puppetmaster.sh
# authenticates by writing the deploy key and setting GIT_SSH_COMMAND, which
# an https:// URL ignores. A private repo over https would prompt for a
# password at boot and the clone would fail.
control_repo_url                  = "git@github.com:Gorak4u/cassandra-control-repo.git"
control_repo_deploy_key_secret_id = "amex/nonprod/control-repo-deploy-key"

# "main", NOT the "production" default. puppet_environment is the BRANCH
# cloned -- `git clone --branch "${PUPPET_ENVIRONMENT}"` -- and
# Gorak4u/cassandra-control-repo has only main. Left at the default the clone
# fails with "could not clone ... (branch: production)" and the master never
# converges.
#
# Safe as a code-environment name: the Hiera hierarchy keys on the pp_*
# extensions and facts (pp_environment = nonprod), never on the Puppet code
# environment, so environments/main resolves exactly as environments/production
# would.
puppet_environment = "main"
puppet_collection  = "puppet8"

# ===========================================================================
# JOIN SECRET
# ===========================================================================
# You choose the NAME; bootstrap-account.sh creates the secret (32 random
# bytes) and prints a SHA-256 to paste into the control repo as
# profile_puppetmaster_pfpt::autosign_challenge_password_sha256. It pauses and
# waits for you to commit that before building anything.
join_secret_id = "amex/nonprod/puppet-join-secret"

# ===========================================================================
# TAGS
# ===========================================================================
tags = {
  Owner       = "platform-data"
  Environment = "nonprod"
  ManagedBy   = "terraform"
}
